#!/usr/bin/env python3
"""statusd: serves the recorded runtime state of the fleet's hosts on localhost.

Usage:
    statusd [--addr 127.0.0.1:7311] [--background]

Endpoints (JSON):
    GET /v1/hosts
    GET /v1/hosts/<host>/runs/<deploy>
    GET /v1/hosts/<host>/ports/<port>/events?from=<time>&to=<time>[&page=<n>]
    GET /v1/hosts/<host>/procs/<pid>
"""
import argparse
import json
import os
import socket
import sys
import time
import zlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from datetime import datetime, timedelta, timezone
from urllib.parse import parse_qs, urlsplit

STATE_FILE = "/app/var/statusd/state.bin"
PAGE_SIZE = 4
MAX_WINDOW = timedelta(hours=72)


def keystream(n: int) -> bytearray:
    x = 0x2545F491
    out = bytearray(n)
    for i in range(n):
        x = (x * 1103515245 + 12345) & 0x7FFFFFFF
        out[i] = (x >> 16) & 0xFF
    return out


def load_state(path: str) -> dict:
    raw = open(path, "rb").read()
    plain = bytes(a ^ b for a, b in zip(raw, keystream(len(raw))))
    return json.loads(zlib.decompress(plain))


def parse_time(text):
    try:
        when = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        raise ValueError(f"cannot parse time {text!r}; use ISO 8601, for example 2026-01-31T13:05:00Z")
    if when.tzinfo is None:
        raise ValueError(f"time {text!r} has no UTC offset; add Z or an offset such as +01:00")
    return when.astimezone(timezone.utc)


def fmt_time(when):
    return when.strftime("%Y-%m-%dT%H:%M:%S") + f".{when.microsecond // 1000:03d}Z"


class Store:
    def __init__(self, state: dict):
        self.hosts = state["hosts"]

    def host(self, name):
        h = self.hosts.get(name)
        if h is None:
            raise LookupError(f"unknown host {name}")
        return h

    def run(self, host, deploy):
        h = self.host(host)
        for r in h["runs"]:
            if r["deploy"] == deploy:
                return {
                    "host": host,
                    "deploy": deploy,
                    "requested_rev": r["requested"],
                    "loaded_rev": r["loaded"],
                    "note": r["note"],
                    "started_at": r["started_at"],
                    "finished_at": r["finished_at"],
                    "failed_pids": r["failed_pids"],
                }
        raise LookupError(
            f"no run of {deploy} recorded on {host}; dry runs and runs that did not reach {host} are not recorded"
        )

    def port_events(self, host, port, start, end, page):
        h = self.host(host)
        if start is None or end is None:
            raise ValueError("from and to are required")
        t0, t1 = parse_time(start), parse_time(end)
        if t1 <= t0:
            raise ValueError("to must be later than from")
        if t1 - t0 > MAX_WINDOW:
            raise ValueError("the window from..to may span at most 72 hours")
        lo, hi = fmt_time(t0), fmt_time(t1)
        hits = [e for e in h["ports"].get(str(port), []) if lo <= e[0] < hi]
        pages = max(1, -(-len(hits) // PAGE_SIZE))
        if page < 1 or page > pages:
            raise ValueError(f"page must be between 1 and {pages}")
        chunk = hits[(page - 1) * PAGE_SIZE:page * PAGE_SIZE]
        return {
            "host": host,
            "port": port,
            "from": lo,
            "to": hi,
            "page": page,
            "pages": pages,
            "events": [{"at": at, "event": kind, "pid": pid} for at, kind, pid in chunk],
        }

    def proc(self, host, pid):
        p = self.host(host)["procs"].get(str(pid))
        if p is None:
            raise LookupError(f"no process {pid} recorded on {host}")
        return {"host": host, "pid": pid, **p}


def make_handler(store: Store):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            sys.stderr.write("statusd: " + (fmt % args) + "\n")

        def reply(self, code, body):
            data = (json.dumps(body, indent=2) + "\n").encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            url = urlsplit(self.path)
            parts = [p for p in url.path.split("/") if p]
            query = parse_qs(url.query)
            try:
                if parts == ["v1", "hosts"]:
                    return self.reply(200, {"hosts": sorted(store.hosts)})
                if len(parts) == 6 and parts[:2] == ["v1", "hosts"] and parts[3] == "ports" and parts[5] == "events":
                    page = query.get("page", ["1"])[0]
                    if not page.isdigit():
                        raise ValueError("page must be a positive integer")
                    return self.reply(200, store.port_events(
                        parts[2], int(parts[4]), query.get("from", [None])[0], query.get("to", [None])[0], int(page)))
                if len(parts) == 5 and parts[:2] == ["v1", "hosts"]:
                    host, kind, key = parts[2], parts[3], parts[4]
                    if kind == "runs":
                        return self.reply(200, store.run(host, key))
                    if kind == "procs":
                        return self.reply(200, store.proc(host, int(key)))
                return self.reply(404, {"error": f"no such endpoint {url.path}"})
            except LookupError as e:
                return self.reply(404, {"error": str(e.args[0])})
            except ValueError as e:
                msg = str(e.args[0]) if e.args else ""
                if msg.startswith("invalid literal"):
                    msg = "port and pid must be integers"
                return self.reply(400, {"error": msg})

    return Handler


def reachable(host, port):
    try:
        with socket.create_connection((host, port), timeout=0.5):
            return True
    except OSError:
        return False


def main():
    ap = argparse.ArgumentParser(prog="statusd")
    ap.add_argument("--addr", help="host:port to listen on (127.0.0.1:7311 when omitted)")
    ap.add_argument("--state", help=f"state file ({STATE_FILE} when omitted)")
    ap.add_argument("--background", action="store_true", help="detach and return once the service is listening")
    args = ap.parse_args()
    args.addr = args.addr or "127.0.0.1:7311"
    args.state = args.state or STATE_FILE
    host, _, port = args.addr.rpartition(":")
    port = int(port)
    if reachable(host, port):
        print(f"statusd already listening on {host}:{port}")
        return 0
    if args.background:
        if os.fork() > 0:
            for _ in range(100):
                if reachable(host, port):
                    print(f"statusd listening on {host}:{port}")
                    return 0
                time.sleep(0.1)
            print("statusd did not come up; see /tmp/statusd.log", file=sys.stderr)
            return 1
        os.setsid()
        if os.fork() > 0:
            os._exit(0)
        log = os.open("/tmp/statusd.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        os.dup2(log, 1)
        os.dup2(log, 2)
        devnull = os.open(os.devnull, os.O_RDONLY)
        os.dup2(devnull, 0)
    store = Store(load_state(args.state))
    server = ThreadingHTTPServer((host, port), make_handler(store))
    if not args.background:
        print(f"statusd listening on {host}:{port}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    sys.exit(main())
