#!/usr/bin/env python3
"""statusd: serves the recorded runtime state of the fleet's hosts on localhost.

Usage:
    statusd [--addr 127.0.0.1:7311] [--background]

Endpoints (JSON):
    GET /v1/hosts
    GET /v1/hosts/<host>/runs/<deploy>
    GET /v1/hosts/<host>/ports/<port>[?after=<deploy>]
    GET /v1/hosts/<host>/procs/<pid>
"""
import argparse
import json
import os
import socket
import sys
import time
import zlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

STATE_FILE = "/app/var/statusd/state.bin"


def keystream(n: int) -> bytearray:
    x = 0x2545F491
    out = bytearray(n)
    for i in range(n):
        x = (x * 1103515245 + 12345) & 0x7FFFFFFF
        out[i] = (x >> 16) & 0xFF
    return out


def load_state(path: str) -> dict:
    raw = open(path, "rb").read()
    plain = bytes(a ^ b for a, b in zip(raw, keystream(len(raw))))
    return json.loads(zlib.decompress(plain))


class Store:
    def __init__(self, state: dict):
        self.hosts = state["hosts"]

    def host(self, name):
        h = self.hosts.get(name)
        if h is None:
            raise LookupError(f"unknown host {name}")
        return h

    def run(self, host, deploy):
        h = self.host(host)
        for r in h["runs"]:
            if r["deploy"] == deploy:
                return {
                    "host": host,
                    "deploy": deploy,
                    "requested_rev": r["requested"],
                    "loaded_rev": r["loaded"],
                    "note": r["note"],
                }
        raise LookupError(
            f"no run of {deploy} recorded on {host}; dry runs and runs that did not target {host} are not recorded"
        )

    def port(self, host, port, after):
        h = self.host(host)
        runs = h["runs"]
        if not runs:
            raise LookupError(f"no runs recorded on {host}")
        if after is None:
            run = runs[-1]
        else:
            match = [r for r in runs if r["deploy"] == after]
            if not match:
                raise LookupError(f"no run of {after} recorded on {host}")
            run = match[0]
        pid = run["ports"].get(str(port))
        out = {"host": host, "port": port, "after": run["deploy"]}
        if pid is None:
            out["state"] = "free"
        else:
            out["state"] = "listening"
            out["pid"] = pid
        return out

    def proc(self, host, pid):
        p = self.host(host)["procs"].get(str(pid))
        if p is None:
            raise LookupError(f"no process {pid} recorded on {host}")
        return {"host": host, "pid": pid, **p}


def make_handler(store: Store):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            sys.stderr.write("statusd: " + (fmt % args) + "\n")

        def reply(self, code, body):
            data = (json.dumps(body, indent=2) + "\n").encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            url = urlsplit(self.path)
            parts = [p for p in url.path.split("/") if p]
            query = parse_qs(url.query)
            try:
                if parts == ["v1", "hosts"]:
                    return self.reply(200, {"hosts": sorted(store.hosts)})
                if len(parts) == 5 and parts[:2] == ["v1", "hosts"]:
                    host, kind, key = parts[2], parts[3], parts[4]
                    if kind == "runs":
                        return self.reply(200, store.run(host, key))
                    if kind == "ports":
                        after = query.get("after", [None])[0]
                        return self.reply(200, store.port(host, int(key), after))
                    if kind == "procs":
                        return self.reply(200, store.proc(host, int(key)))
                return self.reply(404, {"error": f"no such endpoint {url.path}"})
            except LookupError as e:
                return self.reply(404, {"error": str(e.args[0])})
            except ValueError:
                return self.reply(400, {"error": "port and pid must be integers"})

    return Handler


def reachable(host, port):
    try:
        with socket.create_connection((host, port), timeout=0.5):
            return True
    except OSError:
        return False


def main():
    ap = argparse.ArgumentParser(prog="statusd")
    ap.add_argument("--addr", help="host:port to listen on (127.0.0.1:7311 when omitted)")
    ap.add_argument("--state", help=f"state file ({STATE_FILE} when omitted)")
    ap.add_argument("--background", action="store_true", help="detach and return once the service is listening")
    args = ap.parse_args()
    args.addr = args.addr or "127.0.0.1:7311"
    args.state = args.state or STATE_FILE
    host, _, port = args.addr.rpartition(":")
    port = int(port)
    if reachable(host, port):
        print(f"statusd already listening on {host}:{port}")
        return 0
    if args.background:
        if os.fork() > 0:
            for _ in range(100):
                if reachable(host, port):
                    print(f"statusd listening on {host}:{port}")
                    return 0
                time.sleep(0.1)
            print("statusd did not come up; see /tmp/statusd.log", file=sys.stderr)
            return 1
        os.setsid()
        if os.fork() > 0:
            os._exit(0)
        log = os.open("/tmp/statusd.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        os.dup2(log, 1)
        os.dup2(log, 2)
        devnull = os.open(os.devnull, os.O_RDONLY)
        os.dup2(devnull, 0)
    store = Store(load_state(args.state))
    server = ThreadingHTTPServer((host, port), make_handler(store))
    if not args.background:
        print(f"statusd listening on {host}:{port}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    sys.exit(main())
