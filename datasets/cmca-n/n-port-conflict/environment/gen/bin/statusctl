#!/usr/bin/env python3
"""statusctl: command line client for statusd.

    statusctl hosts
    statusctl run <host> <deploy>
    statusctl port <host> <port> --from <time> --to <time> [--page <n>]
    statusctl proc <host> <pid>
"""
import argparse
import json
import sys
import urllib.error
import urllib.request
from urllib.parse import quote


def main():
    ap = argparse.ArgumentParser(prog="statusctl")
    ap.add_argument("--addr", help="host:port of statusd (127.0.0.1:7311 when omitted)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("hosts", help="list known hosts")
    r = sub.add_parser("run", help="what a deploy run did on a host")
    r.add_argument("host")
    r.add_argument("deploy")
    p = sub.add_parser("port", help="bind and release events on a port within a time window")
    p.add_argument("host")
    p.add_argument("port", type=int)
    p.add_argument("--from", dest="start", required=True, metavar="TIME", help="window start, ISO 8601 with Z or an offset")
    p.add_argument("--to", dest="end", required=True, metavar="TIME", help="window end (exclusive), at most 72 hours after --from")
    p.add_argument("--page", type=int, help="page of the result (1 when omitted)")
    q = sub.add_parser("proc", help="describe a process")
    q.add_argument("host")
    q.add_argument("pid", type=int)
    args = ap.parse_args()
    args.addr = args.addr or "127.0.0.1:7311"
    if args.cmd == "port":
        args.page = args.page or 1

    if args.cmd == "hosts":
        path = "/v1/hosts"
    elif args.cmd == "run":
        path = f"/v1/hosts/{quote(args.host)}/runs/{quote(args.deploy)}"
    elif args.cmd == "port":
        path = (f"/v1/hosts/{quote(args.host)}/ports/{args.port}/events"
                f"?from={quote(args.start)}&to={quote(args.end)}&page={args.page}")
    else:
        path = f"/v1/hosts/{quote(args.host)}/procs/{args.pid}"

    try:
        with urllib.request.urlopen(f"http://{args.addr}{path}", timeout=5) as resp:
            body = resp.read().decode()
            code = 0
    except urllib.error.HTTPError as e:
        body = e.read().decode()
        code = 1
    except urllib.error.URLError:
        print(f"statusctl: cannot reach statusd at {args.addr}; start it with /app/bin/statusd --background", file=sys.stderr)
        return 2
    sys.stdout.write(json.dumps(json.loads(body), indent=2) + "\n")
    return code


if __name__ == "__main__":
    sys.exit(main())
