{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "cmca-submission/1"
    },
    "release": {
      "type": "string"
    },
    "board": {
      "type": "string"
    },
    "config_id": {
      "type": "string"
    },
    "harness": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "route",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "permission_mode": {
      "type": "string"
    },
    "profiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "string"
    },
    "harbor_version": {
      "type": "string"
    },
    "injector_build": {
      "type": "string"
    },
    "submitter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "affiliation": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "affiliation",
        "contact"
      ],
      "additionalProperties": false
    },
    "deviations": {
      "type": "string"
    },
    "hub": {
      "type": "object",
      "properties": {
        "jobs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "jobs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "release",
    "board",
    "config_id",
    "harness",
    "model",
    "permission_mode",
    "profiles",
    "attempts",
    "seed",
    "harbor_version",
    "injector_build",
    "submitter",
    "deviations",
    "hub"
  ],
  "additionalProperties": false
}
