{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "tt-engine/1"
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "trial_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "harness": {
      "type": "string"
    },
    "layer": {
      "type": "string",
      "enum": [
        "service",
        "native"
      ]
    },
    "workspace_root": {
      "default": "/app",
      "type": "string"
    },
    "profile": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "tt-profile/1"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "base_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_faults_per_trial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warmup_calls": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "persistence": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(transient|outage|sticky_[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "outage_window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "weights": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "deny",
              "err",
              "inarg",
              "empty",
              "trunc",
              "falsefail",
              "poison",
              "drift",
              "latency",
              "rate",
              "byz"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "class_rate_multipliers": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "shell",
              "fs.read",
              "fs.write",
              "fs.edit",
              "fs.search",
              "fs.list",
              "mcp"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "schema",
        "name",
        "base_rate",
        "max_faults_per_trial",
        "warmup_calls",
        "persistence",
        "weights",
        "class_rate_multipliers"
      ],
      "additionalProperties": false
    },
    "parity_set": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "deny",
          "err",
          "inarg",
          "empty",
          "trunc",
          "falsefail",
          "poison",
          "drift",
          "latency",
          "rate",
          "byz"
        ]
      }
    },
    "catalog_version": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "tt-task/1"
        },
        "exposure": {
          "default": {
            "expected_classes": []
          },
          "type": "object",
          "properties": {
            "expected_classes": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "expected_classes"
          ],
          "additionalProperties": false
        },
        "poison": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "pattern": "^(fs\\.(read|write|edit|search|list)|shell|mcp\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)$"
              },
              "match": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "variant": {
                "type": "string"
              },
              "token": {
                "type": "string",
                "minLength": 6
              }
            },
            "required": [
              "tool",
              "match",
              "variant",
              "token"
            ],
            "additionalProperties": false
          }
        },
        "non_idempotent": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "pattern": "^(fs\\.(read|write|edit|search|list)|shell|mcp\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)$"
              }
            },
            "required": [
              "tool"
            ],
            "additionalProperties": false
          }
        },
        "drift": {
          "default": [],
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "pattern": "^(fs\\.(read|write|edit|search|list)|shell|mcp\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)$"
                  },
                  "kind": {
                    "type": "string",
                    "const": "rename_key"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                },
                "required": [
                  "tool",
                  "kind",
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "pattern": "^(fs\\.(read|write|edit|search|list)|shell|mcp\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)$"
                  },
                  "kind": {
                    "type": "string",
                    "const": "wrap"
                  },
                  "under": {
                    "type": "string"
                  }
                },
                "required": [
                  "tool",
                  "kind",
                  "under"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "pattern": "^(fs\\.(read|write|edit|search|list)|shell|mcp\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)$"
                  },
                  "kind": {
                    "type": "string",
                    "const": "number_as_string"
                  }
                },
                "required": [
                  "tool",
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "alternatives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "pattern": "^(fs\\.(read|write|edit|search|list)|shell|mcp\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)$"
              },
              "via": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(fs\\.(read|write|edit|search|list)|shell|mcp\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)$"
                }
              }
            },
            "required": [
              "tool",
              "via"
            ],
            "additionalProperties": false
          }
        },
        "exempt": {
          "default": {
            "paths": []
          },
          "type": "object",
          "properties": {
            "paths": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "paths"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "exposure",
        "poison",
        "non_idempotent",
        "drift",
        "alternatives",
        "exempt"
      ],
      "additionalProperties": false
    },
    "exempt_paths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "seed",
    "trial_id",
    "task_id",
    "attempt",
    "harness",
    "layer",
    "workspace_root",
    "profile",
    "parity_set",
    "catalog_version",
    "task",
    "exempt_paths",
    "variants"
  ],
  "additionalProperties": false
}
