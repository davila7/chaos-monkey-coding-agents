{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "tt-capabilities/1"
    },
    "harness": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "tool_map": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "faults": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "deny",
          "err",
          "inarg",
          "empty",
          "trunc",
          "falsefail",
          "poison",
          "drift",
          "latency",
          "rate",
          "byz"
        ]
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "supported": {
                "type": "boolean",
                "const": true
              },
              "delivered_as": {
                "type": "string"
              },
              "attribution_visible": {
                "type": "boolean"
              },
              "runs_passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "supported",
              "delivered_as",
              "attribution_visible",
              "runs_passed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "supported": {
                "type": "boolean",
                "const": false
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "supported",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "crash_behavior": {
      "type": "string",
      "enum": [
        "fail_open",
        "fail_closed",
        "unknown"
      ]
    },
    "injector_p95_ms": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "harness",
    "version",
    "generated_at",
    "tool_map",
    "faults",
    "crash_behavior",
    "injector_p95_ms"
  ],
  "additionalProperties": false
}
