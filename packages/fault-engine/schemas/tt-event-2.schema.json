{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "tt-event/2"
    },
    "seq": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "type": "string"
    },
    "trial_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "harness": {
      "type": "string"
    },
    "layer": {
      "type": "string",
      "enum": [
        "service",
        "native"
      ]
    },
    "tool_name": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "args_hash": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "occurrence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decision": {
      "type": "string",
      "enum": [
        "apply",
        "pass",
        "error"
      ]
    },
    "type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "deny",
            "err",
            "inarg",
            "empty",
            "trunc",
            "falsefail",
            "poison",
            "drift",
            "latency",
            "rate",
            "byz"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "exempt_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "persistence": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "transient",
            "sticky",
            "outage",
            "stale"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "seq",
    "ts",
    "trial_id",
    "task_id",
    "attempt",
    "harness",
    "layer",
    "tool_name",
    "capability",
    "args_hash",
    "key",
    "occurrence",
    "decision",
    "type",
    "payload_id",
    "exempt_reason",
    "agent_id",
    "latency_ms"
  ],
  "additionalProperties": false
}
