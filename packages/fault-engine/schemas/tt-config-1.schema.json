{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "tt-config/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "harness": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "harbor_agent": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "route",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "full"
        },
        "native_setting": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "native_setting"
      ],
      "additionalProperties": false
    },
    "axes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "native",
          "fixed"
        ]
      }
    },
    "tracks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "s",
          "n"
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "wall_clock_minutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_turns": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "wall_clock_minutes",
        "max_turns"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "harness",
    "model",
    "autonomy",
    "axes",
    "tracks",
    "limits"
  ],
  "additionalProperties": false
}
