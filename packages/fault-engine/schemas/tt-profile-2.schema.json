{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "tt-profile/2"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "base_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "max_applied_per_trial": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "warmup_calls": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "persistence": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(transient|outage|sticky_[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "outage_window": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "weights": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "deny",
          "err",
          "inarg",
          "empty",
          "trunc",
          "falsefail",
          "poison",
          "drift",
          "latency",
          "rate",
          "byz"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "class_rate_multipliers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "shell",
          "fs.read",
          "fs.write",
          "fs.edit",
          "fs.search",
          "fs.list",
          "mcp"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "targeted": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "poison",
          "falsefail"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "required": [
    "schema",
    "name",
    "base_rate",
    "max_applied_per_trial"
  ],
  "additionalProperties": false
}
