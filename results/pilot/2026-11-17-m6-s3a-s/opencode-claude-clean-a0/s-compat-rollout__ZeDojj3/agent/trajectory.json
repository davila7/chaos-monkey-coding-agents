            "source_call_id": "toolu_0123gdF4g3JJvYUJxxdbGT8j",
            "content": "{\"id\":\"release-2026-10-manifest\",\"title\":\"Release 2026.10 manifest\",\"tags\":[\"manifest\",\"release\"],\"updated_at\":\"2026-10-09\",\"body\":\"# Release 2026.10 manifest\\n\\nStatus: current. Final manifest, published 2026-10-09. Replaces release candidate 1.\\n\\n| Service | Version |\\n|---|---|\\n| billing-api | 8.1.0 |\\n| cart-svc | 5.4.0 |\\n| catalog-svc | 7.2.0 |\\n| checkout-web | 9.0.0 |\\n| email-worker | 1.9.0 |\\n| inventory-sync | 2.4.0 |\\n| ledger-api | 6.0.0 |\\n| orders-api | 3.3.0 |\\n| pricing-svc | 3.10.0 |\\n| search-api | 1.14.0 |\\n| session-svc | 2.6.0 |\\n\"}"
