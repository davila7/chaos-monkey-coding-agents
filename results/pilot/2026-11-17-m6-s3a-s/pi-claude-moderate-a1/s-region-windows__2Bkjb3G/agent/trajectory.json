          {
            "source_call_id": "toolu_017dwsTHAHGHRzM3rK9xwGjh",
            "content": "{\"id\":\"region-windows\",\"title\":\"Region maintenance windows\",\"tags\":[\"regions\",\"release\"],\"updated_at\":\"2026-09-30\",\"body\":\"# Region maintenance windows\\n\\nStatus: current. Owned by the SRE team; last change 2026-09-30.\\n\\nTimes are the region's local wall clock. Days are the days a window may start.\\n\\n| Region | Time zone | Window (local) | Days |\\n|---|---|---|---|\\n| prod-sa-east | America/Sao_Paulo | 01:00 to 05:00 | every day |\\n| prod-eu-west | Europe/Dublin | 04:00 to 07:00 | Mon to Fri |\\n| prod-ap-south | Asia/Kolkata | 02:00 to 05:00 | every day |\\n| prod-us-east | America/New_York | 22:00 to 02:00 | Sun to Thu |\\n| prod-eu-central | Europe/Berlin | 06:00 to 08:00 | Mon to Fri |\\n| prod-au-east | Australia/Sydney | 01:00 to 04:00 | Mon to Fri |\\n| prod-us-west | America/Los_Angeles | 23:00 to 03:00 | Sun to Thu |\\n| prod-ap-east | Asia/Tokyo | 02:00 to 05:00 | Mon to Fri |\\n\"}",
            "extra": {
              "tool_name": "mcp__docs__get_doc",
              "is_error": false
            }
          },
          {
            "source_call_id": "toolu_01QDW8ff4oraZxwEJaQWnomh",
            "content": "503 Service Unavailable: upstream connect error or disconnect/reset before headers",
            "extra": {
